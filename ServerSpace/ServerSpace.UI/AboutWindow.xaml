<Window x:Class="ServerSpace.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutTitle}"
        Icon="Assets/ServerSpace.ico"
        Width="660"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Image Source="Assets/ServerSpace-Icon-512.png" Width="64" Height="64"
                   Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ServerSpace" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionTextBlock" Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Portable Windows Storage Analyzer" Margin="0,5,0,0"
                           FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="{DynamicResource AboutDevelopedBy}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Jürgen Schön" FontSize="16" Margin="0,2,0,0" />

                <TextBlock Text="{DynamicResource AboutLicense}" FontWeight="SemiBold" Margin="0,16,0,3" />
                <TextBlock>
                    <Hyperlink x:Name="LicenseLink" Foreground="{StaticResource AccentBrush}"
                               Click="LicenseLink_Click"><Run Text="MIT License" /></Hyperlink>
                </TextBlock>

                <TextBlock Text="{DynamicResource AboutTechnology}" FontWeight="SemiBold" Margin="0,16,0,3" />
                <TextBlock Text="C# / .NET 10   ·   WPF   ·   Windows x64"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource AboutFreeOpenSource}" Margin="0,16,0,0"
                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource AboutAi1}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource AboutAi2}" TextWrapping="Wrap"
                           Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="{DynamicResource AboutProject}" FontWeight="SemiBold" Margin="0,16,0,3" />
                    <TextBlock>
                        <Hyperlink x:Name="ProjectLink" Foreground="{StaticResource AccentBrush}"
                               Click="ProjectLink_Click"><Run Text="{DynamicResource AboutProjectLink}" /></Hyperlink>
                    </TextBlock>

                <TextBlock Text="{DynamicResource AboutOrganization}" FontWeight="SemiBold" Margin="0,12,0,3" />
                    <TextBlock>
                        <Hyperlink x:Name="OrganizationLink" Foreground="{StaticResource AccentBrush}"
                               Click="OrganizationLink_Click"><Run Text="{DynamicResource AboutOrganizationLink}" /></Hyperlink>
                    </TextBlock>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="© 2026 Jürgen Schön" Margin="0,22,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" />
    </Grid>
</Window>

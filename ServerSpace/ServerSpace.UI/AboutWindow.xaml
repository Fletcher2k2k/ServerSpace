<Window x:Class="ServerSpace.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutTitle}"
        Icon="Assets/ServerSpace.ico"
        Width="480"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="ServerSpace" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionTextBlock" Margin="0,3,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="Portable Windows Storage Analyzer" Margin="0,5,0,0"
                       HorizontalAlignment="Center" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,18,0,14" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource AboutDevelopedBy}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="Jürgen Schön" FontSize="16" Margin="0,2,0,0" />
            <TextBlock Text="{DynamicResource AboutFreeOpenSource}" Margin="0,12,0,0"
                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="{DynamicResource AboutAi1}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource AboutAi2}"
                       TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock Text="{DynamicResource AboutTechnology}" FontWeight="SemiBold" Margin="0,20,0,4" />
            <TextBlock Text="C# / .NET 10   ·   WPF   ·   Windows x64" Foreground="{StaticResource TextSecondaryBrush}" />

            <StackPanel x:Name="LinksPanel" Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource AboutLinks}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Button x:Name="ProjectWebsiteButton" Content="{DynamicResource AboutWebsite}" HorizontalAlignment="Left"
                        Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        Click="ProjectWebsiteButton_Click" />
                <Button x:Name="SourceCodeButton" Content="{DynamicResource AboutSourceCode}" HorizontalAlignment="Left"
                        Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        Click="SourceCodeButton_Click" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="© 2026 Jürgen Schön" Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Grid.Row="5" Content="{DynamicResource AboutClose}" IsDefault="True" IsCancel="True"
                Width="88" Padding="8,4" HorizontalAlignment="Right" Click="CloseButton_Click" />
    </Grid>
</Window>

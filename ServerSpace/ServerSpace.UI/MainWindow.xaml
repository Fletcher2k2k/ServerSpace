<Window x:Class="ServerSpace.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerSpace" Height="700" Width="1100"
        MinHeight="520" MinWidth="760"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Stretch">
            <MenuItem Header="_Menü">
                <MenuItem x:Name="SaveReportMenuItem" Header="Bericht speichern" InputGestureText="Ctrl+S"
                          Click="SaveReportMenuItem_Click" IsEnabled="False" />
                <MenuItem x:Name="SaveReportAsMenuItem" Header="Bericht speichern unter..." InputGestureText="Ctrl+Shift+S"
                          Click="SaveReportAsMenuItem_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Beenden" InputGestureText="Alt+F4" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem x:Name="FilterMenuItem" Header="Filter" IsCheckable="True"
                          Checked="FilterMenuItem_Checked" Unchecked="FilterMenuItem_Unchecked" />
                <MenuItem Header="Spalten">
                    <MenuItem Header="Name" IsCheckable="True" IsChecked="True" IsEnabled="False"
                              Click="ColumnMenuItem_Click" />
                    <MenuItem Header="Größenbalken" IsCheckable="True" IsChecked="True"
                              Click="ColumnMenuItem_Click" />
                    <MenuItem Header="Größe" IsCheckable="True" IsChecked="True"
                              Click="ColumnMenuItem_Click" />
                    <MenuItem Header="Dateien" IsCheckable="True" IsChecked="True"
                              Click="ColumnMenuItem_Click" />
                    <MenuItem Header="Ordner" IsCheckable="True" IsChecked="True"
                              Click="ColumnMenuItem_Click" />
                    <MenuItem Header="Anteil" IsCheckable="True" IsChecked="True"
                              Click="ColumnMenuItem_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Über" Click="AboutMenuItem_Click" />
        </Menu>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dateisystem-Scan" FontSize="19" FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathTextBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                     ToolTip="Lokaler Pfad, gemapptes Laufwerk oder UNC-Pfad" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Durchsuchen" Margin="8,0,0,0"
                    Padding="14,4" Click="BrowseButton_Click" />
            <Button x:Name="OpenPathButton" Grid.Column="2" Content="📁" Margin="8,0,0,0"
                    Padding="8,4" ToolTip="Im Explorer öffnen" Click="OpenPathButton_Click" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ScanButton" Content="Scannen" Padding="18,5"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource AccentTextBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    Click="ScanButton_Click" />
            <Button x:Name="CancelButton" Content="Abbrechen" Padding="18,5" Margin="8,0,0,0"
                    IsEnabled="False" Click="CancelButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Border x:Name="FilterPanel" Visibility="Collapsed" Margin="0,6,0,0"
                    Padding="8" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceSecondaryBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="NameFilterCheckBox" Content="Name enthält" VerticalAlignment="Center"
                                  Checked="FilterOptionChanged" Unchecked="FilterOptionChanged" />
                        <TextBox x:Name="NameFilterTextBox" Width="180" Height="26" Margin="8,0,0,0"
                                 IsEnabled="False" TextChanged="FilterTextChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="MinimumSizeCheckBox" Content="Mindestgröße" VerticalAlignment="Center"
                                  Checked="FilterOptionChanged" Unchecked="FilterOptionChanged" />
                        <TextBox x:Name="MinimumSizeTextBox" Width="80" Height="26" Margin="8,0,0,0"
                                 IsEnabled="False" TextChanged="FilterTextChanged" />
                        <ComboBox x:Name="MinimumSizeUnitComboBox" Width="70" Height="26" Margin="4,0,0,0"
                                  IsEnabled="False" SelectedIndex="0" SelectionChanged="FilterUnitChanged">
                            <ComboBoxItem Content="MB" Tag="1048576" />
                            <ComboBoxItem Content="GB" Tag="1073741824" />
                            <ComboBoxItem Content="TB" Tag="1099511627776" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="HideEmptyFoldersCheckBox" Content="Leere Ordner ausblenden"
                              Checked="FilterOptionChanged" Unchecked="FilterOptionChanged" />
                    <Button Content="Filter zurücksetzen" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Padding="8,2" Click="ResetFilterButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dateien" FontWeight="SemiBold" />
                <TextBlock x:Name="FilesTextBlock" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Ordner" FontWeight="SemiBold" />
                <TextBlock x:Name="DirectoriesTextBlock" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Gelesene Daten" FontWeight="SemiBold" />
                <TextBlock x:Name="BytesTextBlock" Text="0 B" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Laufzeit" FontWeight="SemiBold" />
                <TextBlock x:Name="DurationTextBlock" Text="00:00:00" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Fehler" FontWeight="SemiBold" />
                <TextBlock x:Name="ErrorsTextBlock" Text="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ScanProgressBar" Grid.Row="0" Height="8" IsIndeterminate="False" />
            <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="Aktueller Pfad:" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentPathTextBlock" Grid.Row="2" Text="-" TextWrapping="Wrap" />

            <DataGrid x:Name="ResultsDataGrid" Grid.Row="3" Margin="0,8,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ItemsSource="{Binding VisibleRows}"
                      Sorting="ResultsDataGrid_Sorting"
                      LoadingRow="ResultsDataGrid_LoadingRow"
                      MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="24" Height="22" Padding="0" Margin="0,0,4,0"
                                            Content="{Binding ExpandGlyph}" Tag="{Binding}"
                                            IsEnabled="{Binding HasChildren}"
                                            Click="ToggleRowButton_Click" />
                                    <TextBlock Text="{Binding Name}" Margin="{Binding NameMargin}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Größe grafisch" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="140" Height="12" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Border Width="{Binding BarWidth}" Height="12" HorizontalAlignment="Left"
                                            Background="{StaticResource AccentBrush}" CornerRadius="2" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Größe" Width="120" Binding="{Binding SizeDisplay}" />
                    <DataGridTextColumn Header="Dateien" Width="90" Binding="{Binding FileCountDisplay}" />
                    <DataGridTextColumn Header="Ordner" Width="90" Binding="{Binding DirectoryCountDisplay}" />
                    <DataGridTextColumn Header="Anteil" Width="80" Binding="{Binding RootPercentageDisplay}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="ResultTextBlock" Grid.Row="4" Margin="6,6,6,0" Padding="4,2"
                       Background="{StaticResource StatusBarBrush}"
                       Text="Noch kein Scan ausgeführt." />
        </Grid>
    </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ServerSpace</AssemblyName>
    <ApplicationIcon>Assets\ServerSpace.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>ServerSpace</Product>
    <Description>Portable Windows Storage Analyzer</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ServerSpace.ico" />
    <ProjectReference Include="..\ServerSpace.Core\ServerSpace.Core.csproj" />
    <ProjectReference Include="..\ServerSpace.Scanner\ServerSpace.Scanner.csproj" />
  </ItemGroup>

</Project>
